# Local compose reads these defaults inline (see docker-compose.yml); this file
# documents the knobs you'll override per environment. No secrets in git.

# Public URL Mattermost advertises (links, CORS, websockets).
MM_SERVICESETTINGS_SITEURL=http://localhost:8065

# Postgres DSN. Local compose hardcodes the `db` service; prod gets this from
# `dokku postgres:link` as DATABASE_URL — map it to MM_SQLSETTINGS_DATASOURCE.
# MM_SQLSETTINGS_DATASOURCE=postgres://mmuser:mmuser_password@db:5432/mattermost?sslmode=disable&connect_timeout=10
